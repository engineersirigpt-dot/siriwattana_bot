OPENAI_API_KEY=sk-proj-xxxxx

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_HOURS=8

# Default database mode
# sqlite = stable/default mode, uses DB_PATH
# postgres = PostgreSQL + pgvector mode, uses DATABASE_URL
DB_ENGINE=sqlite

# SQLite config
DB_PATH=./data/chatbot.db

# PostgreSQL config
# Required only when DB_ENGINE=postgres
# Local Docker example:
# DATABASE_URL=postgresql://chatbot:chatbotpass@localhost:5433/chatbot_test
# Test server example:
# DATABASE_URL=postgresql://mi:password@192.168.x.x:5432/chatbot_test
# Production example:
# DATABASE_URL=postgresql://user:password@db-host:5432/chatbot_prod
DATABASE_URL=

# Thai text typically gets cosine sim ~0.6 for paraphrased questions.
# 0.55 is a good starting point; raise to 0.60+ if false matches appear.
SIMILARITY_THRESHOLD=0.55

LLM_MODEL=gpt-4o-mini

# How hard gpt-5 / o-series think before answering: minimal | low | medium | high.
# Only applies to reasoning models — gpt-4.1 / gpt-4o-mini ignore it.
# "low" keeps quality but avoids the 30-40s answers the API default (medium) gave.
LLM_REASONING_EFFORT=low

# Image generation (gpt-image-1). Quality high = crisper text. IMAGE_SIZE=auto
# lets the model fit the aspect ratio to the content; poster/flyer/แนวตั้ง
# prompts are pinned to the portrait canvas so text isn't clipped.
IMAGE_QUALITY=high
IMAGE_SIZE=auto
IMAGE_SIZE_PORTRAIT=1024x1536

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024

CORS_ORIGIN=http://localhost:3002

UPLOAD_DIR=./data/uploads

# --- MI (Master Information) integration ---
# Optional. When set, the chatbot's /auth/login endpoint accepts MI credentials
# as a fallback after local users fail to authenticate. Leave blank to disable.
# Source view: MI2_AUTHEN.dbo.vw_AUTHEN_user_account (MD5 lowercase passwords).
# Active users are filtered by status = 'ACTIVE'.
# NEVER commit real values for these. Set them in your real .env only.
MI_DB_SERVER=
MI_DB_PORT=1433
MI_DB_USER=
MI_DB_PASSWORD=
MI_DB_NAME=MI2_AUTHEN
MI_CONNECT_TIMEOUT=5

# --- MI single-sign-on (SSO) ---
# Shared HS256 secret used to verify the JWT the central MI portal sends to
# /sso?token=<JWT>. Must match the secret MI signs tokens with. Leave blank to
# disable SSO (users can still log in with the MI username/password above).
# NEVER commit the real value.
MI_JWT_SECRET=
# Where "ออกจากระบบ" sends a user who came in from the MI portal (SSO), e.g.
# http://192.168.5.40/AUTHEN/ — blank = our own login page, as for everyone else.
MI_PORTAL_URL=

# --- Agent V1 (the model picks web search / URL reading, multi-step) ---
# off   = disabled, legacy pipeline unchanged (default)
# admin = admins + usernames in AGENT_V1_USERS (trial group)
# all   = every user
AGENT_V1_MODE=off
AGENT_V1_USERS=
# Guards — defaults shown. AGENT_MODEL defaults to WEB_SEARCH_MODEL.
AGENT_MAX_STEPS=5
AGENT_MAX_WEB_SEARCHES=3
AGENT_MAX_URL_READS=3
AGENT_TIMEOUT_S=90

# --- Code Interpreter V2 (Python in OpenAI's hosted sandbox, no internet) ---
# The model runs it only when needed: exact calculations, Excel/CSV analysis,
# charts, producing .xlsx/.csv/.png files. Independent of AGENT_V1_MODE.
# off / admin (+ CODE_INTERPRETER_USERS) / all — rollback = set off + restart.
CODE_INTERPRETER_MODE=off
CODE_INTERPRETER_USERS=
# Limits — defaults shown.
CODE_INTERPRETER_MODEL=gpt-5
CODE_INTERPRETER_REASONING_EFFORT=low
CODE_INTERPRETER_TIMEOUT_S=180
CODE_INTERPRETER_MAX_RUNS=8
CODE_INTERPRETER_MAX_PER_QUESTION=2
CODE_INTERPRETER_DAILY_LIMIT=20
CODE_INTERPRETER_MAX_INPUT_MB=20
CODE_INTERPRETER_CONTAINER_USD=0.03

# --- Document Engine V3 (create/edit Word, Excel, PowerPoint, PDF) ---
# Same hosted sandbox as Code Interpreter; shares its file limits and daily
# quota (CODE_INTERPRETER_DAILY_LIMIT counts both). off / admin (+ users) / all.
DOCUMENT_ENGINE_MODE=off
DOCUMENT_ENGINE_USERS=
# DOCUMENT_ENGINE_TIMEOUT_S=240
# DOCUMENT_ENGINE_MAX_RUNS=12
# DOCUMENT_ENGINE_OCR_PAGES=20
# DOCUMENT_ENGINE_RENDER_TIMEOUT_S=90

# --- V5 chat UI rollout ---
# off | admin | all — which chat page the frontend shows (off = the classic page).
# Users on V5 can still switch back to the classic page from the sidebar.
UI_V5_MODE=off
UI_V5_USERS=

# --- Models with their own setting (so LLM_MODEL can change safely) ---
# Document translation (translate_manual.py). Default gpt-4.1 — independent of LLM_MODEL.
# TRANSLATE_MODEL=gpt-4.1
# Safety classifier before every answer. Default = LLM_MODEL_CLASSIFIER (gpt-4o-mini);
# check with tests/eval_sensitivity.py (real API, ~฿0.2) before changing it.
# SENSITIVITY_CLASSIFIER_MODEL=gpt-4o-mini

# --- V4.1 Smart Model Routing (model_router.py) ---
# off | admin | all — rules (no classifier call) pick model + reasoning effort
# for the normal answer. off = the legacy classifier → LLM_MODEL / LLM_MODEL_CALC.
MODEL_ROUTING_MODE=off
MODEL_ROUTING_USERS=
# Tiers (defaults shown). A tier whose model can't stream chat falls back to LLM_MODEL;
# the API rejecting a routed model/effort also falls back to LLM_MODEL.
# ROUTE_LIGHT_MODEL=gpt-5-mini       # greetings / thanks
# ROUTE_LIGHT_EFFORT=minimal
# ROUTE_STANDARD_MODEL=              # = LLM_MODEL
# ROUTE_STANDARD_EFFORT=             # = LLM_REASONING_EFFORT
# ROUTE_CALC_MODEL=                  # = LLM_MODEL_CALC
# ROUTE_CALC_EFFORT=medium
# ROUTE_DEEP_MODEL=                  # = LLM_MODEL. gpt-5.5 tried 2026-10-28: better-structured,
#                                    # faster (~46s vs ~80s for a long answer), ~2.2× the cost
# ROUTE_DEEP_EFFORT=medium
# ROUTE_DEEP_MIN_CHARS=500

# --- V4.2 Memory & context (memory.py, context_manager.py) ---
# off | admin | all — long-chat summary + per-user memory ("จำไว้ว่า…").
# Memory is saved only on the user's own command; nothing is saved automatically.
MEMORY_MODE=off
MEMORY_USERS=
# MEMORY_MAX_ITEMS=50
# MEMORY_MAX_CHARS=500
# CONTEXT_RECENT_TURNS=6
# CONTEXT_FULL_TURNS=2
# CONTEXT_TRIM_CHARS=1500
# CONTEXT_SUMMARY_BATCH=2
# CONTEXT_SUMMARY_MODEL=gpt-5-mini
# CONTEXT_SUMMARY_EFFORT=minimal

# --- AI usage report (Admin → การใช้งาน AI) ---
# Default ChatGPT Business price per user per month (USD) for the comparison;
# the admin page can override it. Check the current price before reporting.
CHATGPT_BUSINESS_SEAT_USD=30
# DASHBOARD_USD_TO_THB=36
